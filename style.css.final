*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:#fff;color:#171314;font-family:Inter,Arial,sans-serif}a{color:inherit;text-decoration:none}.home{position:relative;width:1440px;height:2440px;margin:0 auto;background:#fff;overflow:hidden}.site-header{position:absolute;width:1344px;height:1px;left:48px;top:32px;border-top:1px solid #f5e0e8}.wordmark{position:absolute;left:0;top:20px;width:180px;height:24px;font:500 20px/24px Inter,sans-serif;letter-spacing:2.5px}.wordmark-sub{position:absolute;left:0;top:43px;font:400 9px/12px 'DM Mono',monospace;letter-spacing:1px}.site-header nav{position:absolute;right:0;top:22px;display:flex;gap:35px}.site-header nav a{font:500 11px/13px Inter,sans-serif;letter-spacing:1.8px}.hero{position:absolute;inset:0}.kicker{position:absolute;left:48px;top:84px;width:360px;height:14px;margin:0;font:400 11px/14px 'DM Mono',monospace;letter-spacing:1.2px;opacity:0}.hero h1{position:absolute;left:38px;top:117px;width:850px;height:252px;margin:0;font:500 104px/126px 'Cormorant Garamond',Georgia,serif;letter-spacing:-1.2px;color:#171314}.hero h1 em{font-style:normal}.intro{position:absolute;left:48px;top:404px;width:560px;height:90px;margin:0;font:400 25px/30px Inter,sans-serif;color:#171314}.signal{position:absolute;width:568px;height:350px;left:824px;top:158px;background:#cf8ba1;overflow:hidden}.signal-lines{position:absolute;left:44px;right:28px;top:52px;height:160px;background:repeating-linear-gradient(to bottom,rgba(255,255,255,.45) 0,rgba(255,255,255,.45) 1px,transparent 1px,transparent 38px)}.signal-orbit{position:absolute;width:118px;height:118px;left:143px;top:66px;border:1px solid rgba(255,255,255,.65);border-radius:50%}.signal-dot{position:absolute;width:56px;height:56px;left:171px;top:97px;border-radius:50%;background:#fff}.signal span{position:absolute;left:28px;bottom:13px;color:#171314;font:400 7px/9px 'DM Mono',monospace;letter-spacing:.6px}.hero-divider-1,.hero-divider-2{position:absolute;width:1344px;height:1px;left:48px;background:#f5e0e8}.hero-divider-1{top:535px}.hero-divider-2{top:747px}.hero-index{position:absolute;left:48px;top:558px;width:100px;height:14px;font:400 11px/14px 'DM Mono',monospace;letter-spacing:.8px}.hero-pill{position:absolute;width:365px;height:130px;left:496px;top:586px;background:#fbf2f6;border-radius:200px}.hero-link{position:absolute;left:573px;top:639px;width:251px;height:24px;font:500 20px/24px Inter,sans-serif;letter-spacing:1.2px;text-align:left}.journal-section{position:absolute;inset:0}.section-label{position:absolute;margin:0;font:400 11px/14px 'DM Mono',monospace;letter-spacing:1.1px}.journal-label{left:48px;top:780px;width:180px;height:14px}.journal-heading{position:absolute;left:48px;top:816px;width:838px;height:92px;margin:0;font:500 58px/70px 'Cormorant Garamond',Georgia,serif;letter-spacing:-.5px}.journal-description{position:absolute;left:52px;top:895px;width:500px;height:48px;margin:0;font:400 20px/24px Inter,sans-serif}.journal-card{position:absolute;width:1344px;height:150px;left:48px;background:#fbf2f6;border-radius:2px}.card-001{top:975px}.card-002{top:1160px}.card-003{top:1345px}.journal-number{position:absolute;left:27px;top:26px;width:60px;height:14px;font:400 11px/14px 'DM Mono',monospace;letter-spacing:1px}.journal-date{position:absolute;left:1188px;top:26px;width:150px;height:14px;font:400 11px/14px 'DM Mono',monospace;letter-spacing:.5px}.journal-title{position:absolute;left:27px;top:57px;width:640px;height:39px;margin:0;font:600 32px/39px 'Cormorant Garamond',Georgia,serif;letter-spacing:-.2px}.journal-text{position:absolute;left:712px;top:58px;width:520px;height:42px;margin:0;font:400 17px/21px Inter,sans-serif}.journal-arrow{position:absolute;left:27px;top:117px;width:180px;height:12px;font:500 10px/12px Inter,sans-serif;letter-spacing:1.2px}.selected-divider{position:absolute;width:1344px;height:1px;left:48px;top:1533px;background:#f5e0e8}.selected-section{position:absolute;inset:0}.selected-label{left:48px;top:1560px;width:220px;height:14px}.selected-heading{position:absolute;left:48px;top:1600px;width:620px;height:68px;margin:0;font:500 56px/68px 'Cormorant Garamond',Georgia,serif;letter-spacing:-.5px}.project-card{position:absolute;width:650px;height:360px;top:1670px;background:#fbf2f6;border-radius:2px}.project-01{left:48px}.project-02{left:742px}.project-meta{position:absolute;left:28px;top:30px;width:220px;height:13px;font:400 10px/13px 'DM Mono',monospace;letter-spacing:1px}.project-title{position:absolute;left:28px;top:70px;width:500px;height:48px;margin:0;font:600 40px/48px 'Cormorant Garamond',Georgia,serif}.project-body{position:absolute;left:28px;top:135px;width:500px;margin:0;font:400 17px/21px Inter,sans-serif}.project-link{position:absolute;left:28px;top:310px;width:180px;height:12px;font:500 10px/12px Inter,sans-serif;letter-spacing:1.2px}.project-pill{position:absolute;width:365px;height:130px;left:950px;top:2174px;background:#fbf2f6;border-radius:200px}.about-section{position:absolute;inset:0}.about-divider{position:absolute;width:1344px;height:1px;left:48px;top:2090px;background:#f5e0e8}.about-label{left:48px;top:2130px;width:160px;height:14px}.about-heading{position:absolute;left:48px;top:2170px;width:760px;height:68px;margin:0;font:500 56px/68px 'Cormorant Garamond',Georgia,serif;letter-spacing:-.5px}.about-body{position:absolute;left:52px;top:2250px;width:700px;height:69px;margin:0;font:400 19px/23px Inter,sans-serif}.about-contact{position:absolute;left:1043px;top:2231px;width:250px;height:24px;font:500 20px/24px Inter,sans-serif;letter-spacing:1.2px}.site-footer{position:absolute;inset:0}.footer-rule{position:absolute;width:1344px;height:1px;left:48px;top:2365px;background:#f5e0e8}.footer-wordmark{position:absolute;left:48px;top:2395px;width:180px;height:13px;font:400 10px/13px 'DM Mono',monospace;letter-spacing:1px}.footer-note{position:absolute;left:1230px;top:2395px;width:300px;height:13px;font:400 10px/13px 'DM Mono',monospace;letter-spacing:.5px}@media(max-width:1440px){.home{margin:0 auto}}@media(max-width:700px){.home{transform-origin:top left;transform:scale(calc(100vw / 1440));margin:0;width:1440px;height:2440px}}
